{
  "name": "mdmaid-desk",
  "version": "0.1.5",
  "type": "module",
  "description": "Persistent local document inbox and reading workspace for Markdown artifacts",
  "keywords": [
    "markdown",
    "mermaid",
    "document-inbox",
    "reader",
    "tui",
    "cli"
  ],
  "author": "Oleksandr Besan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riidii-md/mdmaid.desk"
  },
  "homepage": "https://github.com/riidii-md/mdmaid.desk#readme",
  "bugs": {
    "url": "https://github.com/riidii-md/mdmaid.desk/issues"
  },
  "files": [
    "dist",
    "!dist/*.test.*"
  ],
  "bin": {
    "mdmaid-desk": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage dist/*.test.js",
    "check": "npm run test",
    "package:smoke": "npm run build && node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run check && npm run package:smoke"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.1.0",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdmaid": "^0.1.16",
    "sanitize-html": "^2.17.6",
    "slice-ansi": "^7.1.2",
    "string-width": "^7.2.0"
  }
}
