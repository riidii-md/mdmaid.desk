    "check": "npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.1.0",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.6.2",
    "mdmaid": "^0.1.16",
    "sanitize-html": "^2.17.6",
    "slice-ansi": "^7.1.2",
    "string-width": "^7.2.0"
  }
}
