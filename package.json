{
  "name": "mdmaid.desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent local document inbox and reading workspace for Markdown artifacts",
  "bin": {
    "mdmaid-desk": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js",
